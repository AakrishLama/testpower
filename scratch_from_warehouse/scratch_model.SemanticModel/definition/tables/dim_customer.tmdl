	column LastName
		dataType: string
		lineageTag: dc8ccccb-1cd9-4d2c-b4c0-26d2b74990bb
		sourceLineageTag: LastName
		summarizeBy: none
		sourceColumn: LastName

		annotation SummarizationSetBy = Automatic

	/// Preferred display name for the customer, combining the customer's first and last name. Use this column as the primary customer label when grouping or filtering sales activity by customer.
	column FullName
		dataType: string
		lineageTag: 90337da2-50cb-4758-a389-7f59baa57420
		sourceLineageTag: FullName
		summarizeBy: none
		sourceColumn: FullName

		annotation SummarizationSetBy = Automatic

	/// Customer birth date. Use for customer demographic analysis or age-related grouping only when appropriate; it is not an order or transaction date.
	column BirthDate
		dataType: dateTime
		formatString: General Date
		lineageTag: d765e1fa-fdb7-4be6-bbce-59c4168e3947
		sourceLineageTag: BirthDate
		summarizeBy: none
		sourceColumn: BirthDate

		annotation SummarizationSetBy = Automatic

	/// Customer marital-status attribute. Use to segment or compare sales activity by the recorded marital-status category.
