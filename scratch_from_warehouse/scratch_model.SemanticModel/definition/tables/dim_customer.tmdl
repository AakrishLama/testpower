	/// Customer annual-income attribute as recorded in the source. Use for customer segmentation or comparison; do not interpret it as sales revenue, order value, or profit.
	column AnnualIncome
		dataType: double
		lineageTag: e606d32c-842e-44c0-a666-3608f7d6ec8b
