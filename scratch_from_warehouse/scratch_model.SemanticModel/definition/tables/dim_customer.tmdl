/// Customer dimension containing descriptive attributes for customers associated with sales orders. Use it to group or filter order activity by customer identity, demographics, income, education, occupation, and household characteristics. CustomerKey is a technical relationship key and should not be used as a business label.
table dim_customer
	lineageTag: 7fc16cb7-2ae8-4f2b-a830-db79ea0bde52
	sourceLineageTag: [gold].[dim_customer]

	/// Technical primary key for the customer dimension and the one-side target of the fact_sales customer relationship. Hidden from business-facing analysis; use FullName or other customer attributes as labels.
	column CustomerKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8f0649fa-6631-4642-9a61-50c0836ef9ab
		sourceLineageTag: CustomerKey
		summarizeBy: none
		sourceColumn: CustomerKey

		annotation SummarizationSetBy = Automatic

	/// Customer's first name. Use with LastName or FullName for customer identification and detailed customer-level analysis.
	column FirstName
		dataType: string
		lineageTag: 8bb86b45-df97-4744-9609-740f9981263b
		sourceLineageTag: FirstName
		summarizeBy: none
		sourceColumn: FirstName

		annotation SummarizationSetBy = Automatic

