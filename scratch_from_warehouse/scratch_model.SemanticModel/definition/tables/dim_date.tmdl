/// Calendar dimension used for time filtering and time-intelligence analysis. The active relationship to fact_sales uses Order Date; the inactive relationship uses Stock Date through a dedicated measure. Use Year, Month, and Day for grouping and filtering; these calendar attributes are not additive.
table dim_date
	lineageTag: 2e869106-6740-4022-ae47-267e32568368
	sourceLineageTag: [gold].[dim_date]
	dataCategory: Time

	/// Calendar date used by the date relationships. Hidden so users select calendar attributes instead. It is the active date target for Order Date and the inactive alternate target for Stock Date.
	column DateKey
		dataType: dateTime
		isHidden
		isUnique
		formatString: General Date
		lineageTag: 645297ce-5abf-449d-95b0-c6b27d15cbd0
		sourceLineageTag: DateKey
		summarizeBy: none
		sourceColumn: DateKey

		annotation SummarizationSetBy = Automatic

	/// Calendar year component of DateKey. Use for yearly grouping, filtering, and prior-year comparisons. This is a category attribute, not an additive numeric value.
	column Year
		dataType: int64
		formatString: 0
		lineageTag: e922bcfc-d62a-4b9f-8971-48ffe39b23d3
		sourceLineageTag: Year
		summarizeBy: sum
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	/// Calendar month number from DateKey. Use for month filtering or chronological grouping within a year. This is a calendar attribute, not an additive numeric value.
	column Month
		dataType: int64
		formatString: 0
		lineageTag: 53fde5ce-2782-480f-b004-5c9fdf3d0a77
		sourceLineageTag: Month
		summarizeBy: sum
		sourceColumn: Month

		annotation SummarizationSetBy = Automatic

	/// Day-of-month number from DateKey. Use for daily grouping or filtering when day-level detail is required. This is a calendar attribute, not an additive numeric value.
	column Day
		dataType: int64
		formatString: 0
		lineageTag: 64fcc464-c3db-431a-b2e7-d4cf2e8658d6
		sourceLineageTag: Day
		summarizeBy: sum
		sourceColumn: Day

		annotation SummarizationSetBy = Automatic

	partition dim_date = entity
		mode: directLake
		source
			entityName: dim_date
			schemaName: gold
			expressionSource: 'DirectLake - warehouse'
